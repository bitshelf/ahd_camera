// Android 15 BSP build. Android Studio uses the same sources via build.gradle.kts.
package {
    default_applicable_licenses: ["ahd_camera_license"],
}
license {
    name: "ahd_camera_license",
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

java_binary_host {
    name: "ahd_build_tool",
    srcs: ["tools/src/AhdTools.kt"],
    main_class: "io.github.ahdcamera.tools.AhdToolsKt",
}
genrule {
    name: "ahd_aosp_manifest",
    tools: ["ahd_build_tool"],
    srcs: ["app/src/main/AndroidManifest.xml"],
    out: ["AndroidManifest.xml"],
    cmd: "$(location ahd_build_tool) manifest $(in) $(out)",
}
genrule {
    name: "ahd_aosp_debug_manifest",
    tools: ["ahd_build_tool"],
    srcs: ["app/src/main/AndroidManifest.xml"],
    out: ["AndroidManifest.xml"],
    cmd: "$(location ahd_build_tool) manifest --debug $(in) $(out)",
}
java_defaults {
    name: "ahd_app_defaults",
    srcs: ["app/src/main/java/**/*.kt"],
    resource_dirs: ["app/src/main/res"],
    sdk_version: "current",
    min_sdk_version: "31",
    target_sdk_version: "35",
    java_version: "17",
    static_libs: [
        "androidx.activity_activity-compose",
        "androidx.core_core-ktx",
        "androidx.compose.runtime_runtime",
        "androidx.compose.material3_material3",
        "androidx.compose.ui_ui",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "kotlinx_coroutines_android",
    ],
}
android_app {
    name: "AhdCamera",
    // Preserve the preinstalled App signing identity across firmware updates.
    certificate: "platform",
    defaults: ["ahd_app_defaults"],
    manifest: ":ahd_aosp_manifest",
    optimize: {
        enabled: true,
        shrink: true,
        proguard_flags_files: ["app/proguard-rules.pro"],
    },
}
android_app {
    name: "AhdCameraDebug",
    defaults: ["ahd_app_defaults"],
    manifest: ":ahd_aosp_debug_manifest",
    // Keep the source/resource namespace stable while the APK package has .debug.
    aaptflags: ["--custom-package", "io.github.ahdcamera"],
    optimize: { enabled: false },
}

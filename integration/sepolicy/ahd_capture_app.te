# Dedicated direct capture domain, selected by signer + package + privilege.
type ahd_capture_app, domain;
app_domain(ahd_capture_app)

# Dedicated board-owned capture nodes; generic video_device stays inaccessible.
# Shared hardware has s0 while the app retains its per-app MLS categories.
# Trust only these device objects; do not grant the app mlstrustedsubject.
type vendor_ahd_video_device, dev_type, mlstrustedobject;
allow ahd_capture_app device:dir r_dir_perms;
allow ahd_capture_app vendor_ahd_video_device:chr_file rw_file_perms;
allowxperm ahd_capture_app vendor_ahd_video_device:chr_file ioctl { 0x5600-0x56ff };
allow ahd_capture_app app_api_service:service_manager find;

# Preserve the existing camera service's access to these board nodes.
allow hal_camera vendor_ahd_video_device:chr_file rw_file_perms;

# Neither ordinary apps nor other platform-signed apps acquire direct AHD access.
neverallow { appdomain -ahd_capture_app } vendor_ahd_video_device:chr_file { read write };
